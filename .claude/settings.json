{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-git.sh\"",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Checking branch and working-copy rules..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/claim-working-copy.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
